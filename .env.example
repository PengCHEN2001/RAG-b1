# Copy to .env and replace the placeholder locally.
# Run commands with uv run --env-file .env to load these values.
GOOGLE_API_KEY=your_google_ai_api_key_here

# Optional model overrides.
GEMINI_MODEL=gemini-3.5-flash-lite
# Free-tier pacing and bounded retries for temporary 429/5xx provider failures.
GEMINI_MIN_INTERVAL_SECONDS=5
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_BASE_SECONDS=5
# Optional RAGAS judge override; otherwise it follows GEMINI_MODEL.
# RAGAS_MODEL=gemini-3.5-flash-lite
RAGAS_EMBEDDING_MODEL=models/gemini-embedding-001
